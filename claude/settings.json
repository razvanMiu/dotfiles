{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "effortLevel": "medium",
  "theme": "dark",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.76",
        "--browser",
        "chromium"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.2.1"
      ]
    },
    "serena": {
      "command": "sh",
      "args": [
        "-lc",
        "SERENA_HOME=\"${XDG_STATE_HOME:-$HOME/.local/state}/serena\" exec uvx --from git+https://github.com/oraios/serena@v1.5.3 serena start-mcp-server --context claude-code --project-from-cwd"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${XDG_CONFIG_HOME:-$HOME/.config}/scripts/claude-safety-hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${XDG_CONFIG_HOME:-$HOME/.config}/scripts/claude-safety-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${XDG_CONFIG_HOME:-$HOME/.config}/scripts/claude-safety-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
