{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": [
      "./node_modules/@types",
      "../../.local/share/bun/install/global/node_modules/@types"
    ],
    "types": ["bun", "node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts"]
}
