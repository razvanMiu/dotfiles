{
  "languages": {
    "JavaScript": {
      "language_servers": ["biome", "!eslint", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
