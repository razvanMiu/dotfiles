{
  // Telemetry & Privacy
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },

  // General & Editor
  "base_keymap": "Zed",
  "cli_default_open_behavior": "new_window",
  "vim_mode": false,
  "text_rendering_mode": "platform_default",
  "format_on_save": "on",
  "tab_size": 2,

  // Inlay Hints (Required for Version Lens / Depsy / LSP hints)
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },

  // UI & Theming
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 15.0,
  "buffer_font_size": 15,
  "icon_theme": "Catppuccin Macchiato",
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },

  // Dock & Panels
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // Declarative Extension Management
  "auto_install_extensions": {
    "biome": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "depsy-lsp": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "github-actions": true,
    "golangci-lint": true,
    "html": true,
    "ini": true,
    "make": true,
    "prisma": true,
    "toml": true,
    "vue": true,
  },

  // Language Server Configurations
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["clsx", "cva", "twMerge", "cn", "cx"],
      },
    },
  },

  // Per-Language Overrides
  "languages": {
    "JavaScript": {
      "tab_size": 2,
      "language_servers": ["!biome", "..."],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "tab_size": 2,
      "language_servers": ["!biome", "..."],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "language_servers": ["!biome", "..."],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "Vue.js": {
      "tab_size": 2,
      "language_servers": ["!biome", "..."],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "Python": {
      "tab_size": 4,
      "language_servers": ["basedpyright", "ruff"],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true,
      },
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "language_servers": ["gopls", "golangci-lint"],
      "formatter": {
        "language_server": {
          "name": "gopls",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },
    "CSS": {
      "tab_size": 2,
    },
    "HTML": {
      "tab_size": 2,
    },
    "JSON": {
      "tab_size": 2,
    },
    "JSONC": {
      "tab_size": 2,
    },
  },
}
