# Catppuccin Macchiato dunst theme.
# Palette aligned with ~/.config/rofi/themes/catppuccin-macchiato.rasi

[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 240)
    origin = top-right
    offset = (16, 42)
    notification_limit = 5

    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    word_wrap = true
    ignore_newline = no

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#c6a0f6"
    separator_height = 0
    separator_color = frame
    gap_size = 8
    corner_radius = 14
    corners = all
    transparency = 0

    sort = yes
    indicate_hidden = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 160
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4
    progress_bar_corners = all

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 8

    history_length = 20
    sticky_history = yes

    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

    title = Dunst
    class = Dunst

    # Do not dismiss on accidental left click; use middle click to close.
    # Right click opens dunst's context/action menu through rofi.
    mouse_left_click = none
    mouse_middle_click = close_current
    mouse_right_click = context

[urgency_low]
    background = "#24273a"
    foreground = "#a5adcb"
    frame_color = "#494d64"
    timeout = 6
    default_icon = dialog-information

[urgency_normal]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#c6a0f6"
    timeout = 8
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#ed8796"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
