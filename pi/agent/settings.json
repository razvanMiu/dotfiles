{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "ollama-cloud",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "antigravity/*",
    "google/gemini-3.8*",
    "google/gemini-4-*",
    "openai/gpt-6*",
    "eea-inhouse/**",
    "ollama-cloud/**"
  ],
  "enableSkillCommands": true,
  "skills": ["~/.config/agents/skills"],
  "packages": [
    "npm:pi-web-access@0.46.0",
    "npm:pi-subagents@0.84.0",
    "npm:pi-observational-memory@3.1.4",
    "npm:pi-sensitive-guard@0.5.0",
    "npm:pi-ollama-cloud@0.13.1",
    "npm:@marckrenn/pi-sub-bar@1.5.0",
    "npm:@ayulab/pi-rewind@0.4.6",
    "npm:@ff-labs/pi-fff@0.11.0"
  ],
  "defaultTools": ["+grep", "+find", "+ls"],
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "setopt nonomatch pipefail",
  "subagents": {
    "defaultModel": "ollama-cloud/deepseek-v4.1-flash",
    "agentOverrides": {
      "scout": {
        "model": "ollama-cloud/minimax-m3.1-flash",
        "thinking": "low"
      },
      "researcher": {
        "model": "ollama-cloud/minimax-m3.1-flash",
        "thinking": "medium"
      },
      "worker": {
        "model": "ollama-cloud/deepseek-v4.1-flash",
        "thinking": "high"
      },
      "reviewer": {
        "model": "ollama-cloud/deepseek-v4.1-flash",
        "thinking": "high"
      },
      "oracle": { "model": "ollama-cloud/glm-5.3-flash", "thinking": "high" },
      "evidence-auditor": {
        "model": "ollama-cloud/glm-5.3-flash",
        "thinking": "low"
      },
      "delegate": { "model": "ollama-cloud/gpt-oss:20b", "thinking": "low" }
    }
  },
  "hideThinkingBlock": false,
  "theme": "dark",
  "cacheWarming": "streaming",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 60000
  },
  "observational-memory": {
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.5,
    "compactAfterTokens": 200000,
    "observeAfterTokens": 30000,
    "reflectAfterTokens": 60000,
    "observationsPoolMaxTokens": 15000,
    "observationsPoolTargetTokens": 8000,
    "showWorkerNotifications": true,
    "agentMaxTokens": 8192,
    "model": {
      "provider": "eea-inhouse",
      "id": "Inhouse-LLM/qwen3.8-27b",
      "thinking": "off"
    }
  },
  "terminal": {
    "images": "kitty",
    "hyperlinks": true
  },
  "deviceId": "0cd85e3f-6f52-4f86-841f-7f6282b4a9b1",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access@0.46.0\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"npm:pi-subagents@0.84.0\",\"scope\":\"user\"}": "0.84.0",
    "{\"source\":\"npm:pi-sensitive-guard@0.5.0\",\"scope\":\"user\"}": "0.5.0",
    "{\"source\":\"npm:pi-ollama-cloud@0.13.1\",\"scope\":\"user\"}": "0.13.1",
    "{\"source\":\"npm:@marckrenn/pi-sub-bar@1.5.0\",\"scope\":\"user\"}": "1.5.0"
  }
}
